{
  "listen_host": "0.0.0.0",
  "listen_port": 8443,
  "ws_path": "/cdn",
  "encoding": "binary",
  "server_header": "nginx",
  "cover_page": null,
  "tls_cert": "./certs/relay.crt",
  "tls_key": "./certs/relay.key",
  "profile": "balanced",
  "cover_traffic": true,
  "identity_file": "./data/relay.key",
  "membership_file": "./data/members.json",
  "max_streams": 256,
  "window": 262144,
  "idle_timeout": 300.0,
  "handshake_timeout": 20.0,
  "connect_timeout": 15.0,
  "rekey_seconds": 900.0,
  "stats_interval": 0.0,
  "limit_mbps": null,
  "log_level": "info",
  "log_file": null,
  "egress": {
    "allow_ports": [],
    "deny_ports": [25, 465, 587, 2525],
    "allow_networks": [],
    "deny_networks": [],
    "block_private": true,
    "allow_domains": [],
    "deny_domains": [],
    "resolve_timeout": 10.0,
    "allow_private_literals": false
  }
}
